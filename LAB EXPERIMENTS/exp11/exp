from sklearn.tree import DecisionTreeClassifier

X = [[20, 20000], [25, 30000], [40, 60000],
     [50, 80000], [23, 25000], [45, 70000]]

y = ["Low", "Low", "Good", "Good", "Low", "Good"]

model = DecisionTreeClassifier(random_state=0)
model.fit(X, y)

result = model.predict([[30, 40000]])

print("Credit Score:", result[0])
