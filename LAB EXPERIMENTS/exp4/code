import numpy as np
from sklearn.neural_network import MLPClassifier

# Dataset
X = np.array([[0,0], [0,1], [1,0], [1,1]])
Y = np.array([0, 0, 0, 1])

# ANN using Backpropagation
model = MLPClassifier(hidden_layer_sizes=(2,),
                      activation='logistic',
                      solver='lbfgs',
                      max_iter=1000,
                      random_state=1)

# Train
model.fit(X, Y)

# Test
prediction = model.predict(X)

print("Input     Actual   Predicted")

for i in range(len(X)):
    print(X[i], "   ", Y[i], "       ", prediction[i])
